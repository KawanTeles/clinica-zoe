# ---------------------------------------------------------------------------
# Clínica Zoe — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com os dados do SEU projeto Supabase.
# ---------------------------------------------------------------------------

# --- Supabase (cliente / browser) ------------------------------------------
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://fivsvdgicvqnsngzyjiu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=fivsvdgicvqnsngzyjiu

# --- Supabase (servidor / SSR e server functions) --------------------------
# Mesmos valores acima, sem o prefixo VITE_ (usados via process.env no servidor)
SUPABASE_URL=https://fivsvdgicvqnsngzyjiu.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=fivsvdgicvqnsngzyjiu

# --- Supabase (chave administrativa — NUNCA expor no browser) --------------
# Usada apenas por server functions (admin API, storage assinado, jobs).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# --- Site ------------------------------------------------------------------
# URL pública final (canonical, OG tags, sitemap.xml). Sem barra no final.
VITE_SITE_URL=https://www.suaclinica.com.br
# Opcional: imagem de preview social (URL absoluta https)
VITE_OG_IMAGE=https://www.suaclinica.com.br/og-cover.png

# --- WhatsApp Cloud API (opcional) -----------------------------------------
# Também podem ser gravados na tabela `whatsapp_meta_config` pelo painel admin.
# WHATSAPP_VERIFY_TOKEN=defina_um_token_forte
